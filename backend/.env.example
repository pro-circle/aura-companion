# AURA backend environment — all free tier, no paid services.
# Copy to .env and fill in your own free keys.

# 4 free Groq keys (https://console.groq.com/keys) — separate accounts so limits don't stack.
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=

# 2 free OpenRouter keys (https://openrouter.ai/keys) — only ":free" models are ever requested.
OPENROUTER_API_KEY_1=
OPENROUTER_API_KEY_2=

# Optional overrides (defaults are already free-tier safe)
# GROQ_PRIMARY_MODEL=llama-3.3-70b-versatile
# GROQ_FAST_MODEL=llama-3.1-8b-instant
# GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# GROQ_STT_MODEL=whisper-large-v3-turbo
# OPENROUTER_MODELS=meta-llama/llama-3.3-70b-instruct:free,google/gemma-3-27b-it:free
# ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000
# MAX_HISTORY_TURNS=20
